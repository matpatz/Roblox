{
  "rewrites": [
    { "source": "/", "destination": "/src/frontend/index.html" },
    { "source": "/projects", "destination": "/src/frontend/projects.html" },
    { "source": "/projects/scripts", "destination": "/src/frontend/projects/scripts.html" },
    { "source": "/projects/scripts.json", "destination": "/src/frontend/projects/scripts.json" },
    { "source": "/projects/games", "destination": "/src/frontend/projects/games.html" },
    { "source": "/projects/games.json", "destination": "/src/frontend/projects/games.json" },
    { "source": "/projects/misc", "destination": "/src/frontend/projects/misc.html" },
    { "source": "/projects/misc.json", "destination": "/src/frontend/projects/misc.json" },
    { "source": "/stats", "destination": "/src/frontend/stats.html" },
    { "source": "/setup", "destination": "/src/frontend/setup.html" },
    { "source": "/key-system", "destination": "/src/frontend/key-system/index.html" },
    { "source": "/notepad", "destination": "/src/frontend/notepad/index.html" },
    { "source": "/calculator", "destination": "/src/frontend/calculator/index.html" },
    { "source": "/calculator/:path*", "destination": "/src/frontend/calculator/:path*" },
    { "source": "/pollinations/", "destination": "/src/frontend/pollinations/index.html" },
    { "source": "/pollinations/:path*", "destination": "/src/frontend/pollinations/:path*" }
  ],
  "redirects": [
    { "source": "/pollinations", "destination": "/pollinations/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
